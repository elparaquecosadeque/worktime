{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=worktime;Username=worktime;Password=worktime",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Jwt": {
    "Issuer": "worktime",
    "Audience": "worktime-web",
    "SigningKey": "dev-only-signing-key-change-me-in-compose-0123456789",
    "LifetimeHours": 8
  },
  "Seed": {
    "Enabled": true,
    "ResetInterval": "24:00:00",
    "DemoPassword": "Demo1234!"
  },
  "Cache": {
    "TeamSummarySeconds": 5
  },
  "Diagnostics": {
    "SlowRequestMs": 500
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  }
}
